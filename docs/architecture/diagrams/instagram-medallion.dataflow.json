  "cards": [
    {
      "dot": "cyan",
      "title": "Medallion discipline",
      "items": [
        "Bronze Parquet is as-observed; nothing derived is stored back on it",
        "Silver carries the deduped posts table plus DuckDB watermarks",
        "Enrichment output is an ingested source (ADR-0001), not a transform"
      ]
    },
    {
      "dot": "orange",
      "title": "Where the model work enters",
      "items": [
        "ig_posts_gen_batches enqueues partitions; the worker submits and polls",
        "gold_analyses is an AssetSpec — written externally, never by the transform layer",
        "ops.sqlite holds the queue, the media cache and dead letters"
      ]
    },
    {
      "dot": "emerald",
      "title": "Serving contract",
      "items": [
        "Metrics live in warehouse views; the dashboard is a thin projector (ADR-0005)",
        "Metrics are point-in-time at-post-time baselines, not all-time averages (ADR-0006)",
        "dim_profile, dim_date and v_post_detail anchor the downstream views"
      ]
    },
    {
      "dot": "rose",
      "title": "Target — accepted, not built",
      "items": [
        "ADR-0011: bronze_enrichment_raw → six silver_* conform tables → four gold marts",
        "ADR-0012: Dagster-native orchestration, retiring the ops.sqlite queue",
        "ADR-0013 / 0008 / 0009: the single inference seam is not the running path today"
      ]
    }
  ]
