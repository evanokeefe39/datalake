APIFY_API_TOKEN=
GEMINI_API_KEY=
IG_DB_PATH=data/state.duckdb

# Inference (qwen) service — the enrichment provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Where the orchestration service reaches the jobs service. Compose sets this
# to the service name; a native run uses loopback.
JOBS_SERVICE_URL=http://127.0.0.1:8462

# ── Docker Compose (root docker-compose.yml) ───────────────────────────────
# The ABSOLUTE host path of this checkout's data/ directory. Required by the
# orchestration service: it is the host-side prefix of the path map that
# translates persisted media paths (written as Windows paths by the scraper)
# into the /data paths both containers see.
#
# Wrong or missing -> compose refuses to start, rather than silently handing
# the inference service paths it cannot open.
DATALAKE_HOST_DATA_DIR=C:/Users/evano/repos/datalake/data
# Local ad-hoc scrape dumps (dataset/posts holding post_metadata.json + media).
# Mounted read-only at /data/ingest, which is what IG_LOCAL_INGEST_DIR points at
# inside the orchestration container. If this path does not exist, local-ingest
# seeding finds no source files and silently recovers nothing.
DATALAKE_LOCAL_INGEST_DIR=../scrape-ig-saved-list/data/ingest

# Optional: host port for the Dagster UI (container always listens on 3000).
# Default 7642 — deliberately not 3000/3001/8000/8080, which dev tools and other
# stacks grab constantly. Set this only if 7642 is taken on your machine.
# DAGSTER_HOST_PORT=7642
